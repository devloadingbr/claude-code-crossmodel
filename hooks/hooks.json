{
  "description": "crossmodel — injects the routing policy when the trigger word appears, and announces when a command is about to spend an external provider's quota.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/route.mjs\"",
            "timeout": 10,
            "statusMessage": "crossmodel routing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/delegation-notice.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
